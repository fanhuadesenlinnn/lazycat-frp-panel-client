# 上游 frp-panel 的固定版本信息。
#
# 源码可复现构建（推荐）：使用本地源码目录 + 固定 commit。
UPSTREAM_REPO="https://github.com/VaalaCat/frp-panel"
UPSTREAM_COMMIT="1a58b856d7de19de8669b7072872986d2fa1604a"
# 该 commit 同时带有 v0.1.37 / alpha / latest 标签，可用
#   git -C <upstream> tag --points-at 1a58b856d7de19de8669b7072872986d2fa1604a
# 核对。真正参与校验的是 commit，标签只作为人类可读的版本提示。
UPSTREAM_TAG="v0.1.37"

# 预编译产物回退方案：从 GitHub Release 下载并校验 sha256。
# 留空表示不使用下载方式（默认）。
# 需要下载时，请填写对应版本的 sha256（sha256sum 结果，小写十六进制）。
UPSTREAM_RELEASE_TAG=""
UPSTREAM_LINUX_AMD64_SHA256=""
UPSTREAM_LINUX_ARM64_SHA256=""
